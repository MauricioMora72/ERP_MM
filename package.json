{
  "name": "erp-mm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:migrar": "pnpm --filter @erp/db migrar",
    "dev": "pnpm --parallel --filter @erp/api --filter @erp/web dev",
    "dev:api": "pnpm --filter @erp/api dev",
    "dev:web": "pnpm --filter @erp/web dev",
    "test": "pnpm --filter @erp/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
