# Copie este archivo como .env y ajuste los valores. El archivo .env nunca se sube a GitHub.

# Conexión de administración: solo para aplicar migraciones (dueño de las tablas).
DATABASE_URL_ADMIN=postgres://erp_admin:erp_admin_local@localhost:5432/erp

# Conexión de la aplicación: rol erp_app, que no es dueño de las tablas (la seguridad por fila siempre aplica).
APP_DB_PASSWORD=erp_app_local
DATABASE_URL=postgres://erp_app:erp_app_local@localhost:5432/erp

# Modo de autenticación: "desarrollo" (local, sin Firebase) o "firebase".
AUTH_MODE=desarrollo
# Solo para AUTH_MODE=firebase:
FIREBASE_PROJECT_ID=

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Interfaz web. La web reenvía /api a esta dirección interna de la API.
API_URL_INTERNA=http://localhost:4000
# Déjelo vacío para que el navegador use el mismo origen de la web.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_MODE=desarrollo
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
